#!/usr/bin/python3
from __future__ import division, print_function
from jinja2 import Environment, FileSystemLoader
import yaml
import textwrap
import os, sys, shutil


def file_for_zone(zone):
    return '/var/bind/ns-dyn/{zone}'.format(zone=zone)


def config_named():
    context = {
        'keys': config['keys'],
        'zones': config['zones'],
        'zone_files': { zone: file_for_zone(zone) for zone in config['zones']},
    }
    env.get_template('named.conf.j2').stream(context).dump('/etc/bind/named.conf')


def init_zones():
    if not os.path.exists('/var/bind/ns-dyn'):
        os.mkdir('/var/bind/ns-dyn')
    shutil.chown('/var/bind/ns-dyn', 'named')

    for zone in config['zones']:
        zone_file = file_for_zone(zone)
        if not os.path.exists(zone_file):
           context = { 'zone': zone }
           env.get_template('ns-dyn-initial-zone.j2').stream(context).dump(zone_file)
        shutil.chown(zone_file, 'named')


def run_cmd():
    os.execv(sys.argv[1], sys.argv[1:])


with open('/etc/bind/ns-dyn-config.yaml', 'r') as f:
    config = yaml.safe_load(f)
env = Environment(loader=FileSystemLoader('/etc/bind'))
config_named()
init_zones()
run_cmd()

# vim:tw=120:ts=4:sw=4:expandtab:
